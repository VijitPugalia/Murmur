<Window x:Class="Murmur.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:Murmur.App.ViewModels"
        xmlns:local="clr-namespace:Murmur.App.Windows"
        mc:Ignorable="d"
        Title="Murmur Settings"
        Height="730"
        Width="920"
        MinHeight="620"
        MinWidth="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#F8FAFC"
        d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel, IsDesignTimeCreatable=True}">

    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:InverseBooleanConverter x:Key="InverseBool"/>

        <!-- Settings Card Style -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardHeader" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="CardIcon" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0078D4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <Style x:Key="FieldDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputPasswordBox" TargetType="PasswordBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#0062AD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="secBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="secBorder" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="secBorder" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HotkeyButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"/>

        <!-- Sidebar Tab Button Style -->
        <Style x:Key="SidebarTab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="icon" Text="{TemplateBinding Tag}" FontSize="15" Width="26" Foreground="#64748B" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#BFDBFE"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="icon" Property="Foreground" Value="#0078D4"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar Navigation -->
        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header / App Brand -->
                <Border Grid.Row="0" Padding="18,18,18,14" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="8" Background="#0078D4" Margin="0,0,10,0">
                            <TextBlock Text="🎙️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Murmur" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                <Border Background="#E2E8F0" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="v1.1" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Voice Dictation" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Row="1" Margin="10,12">
                    <RadioButton x:Name="TabGeneral" Style="{StaticResource SidebarTab}" Tag="⚡" IsChecked="True" GroupName="SettingsTabs" Checked="Tab_Checked">
                        <TextBlock Text="Shortcuts &amp; General" FontSize="13" FontWeight="Medium"/>
                    </RadioButton>
                    <RadioButton x:Name="TabAudio" Style="{StaticResource SidebarTab}" Tag="🎙️" GroupName="SettingsTabs" Checked="Tab_Checked">
                        <TextBlock Text="Audio &amp; Recording" FontSize="13" FontWeight="Medium"/>
                    </RadioButton>
                    <RadioButton x:Name="TabAI" Style="{StaticResource SidebarTab}" Tag="🤖" GroupName="SettingsTabs" Checked="Tab_Checked">
                        <TextBlock Text="AI &amp; API Models" FontSize="13" FontWeight="Medium"/>
                    </RadioButton>
                    <RadioButton x:Name="TabMacros" Style="{StaticResource SidebarTab}" Tag="✨" GroupName="SettingsTabs" Checked="Tab_Checked">
                        <TextBlock Text="Macros &amp; Vocab" FontSize="13" FontWeight="Medium"/>
                    </RadioButton>
                    <RadioButton x:Name="TabAdvanced" Style="{StaticResource SidebarTab}" Tag="🛠️" GroupName="SettingsTabs" Checked="Tab_Checked">
                        <TextBlock Text="Advanced &amp; Logs" FontSize="13" FontWeight="Medium"/>
                    </RadioButton>
                </StackPanel>

                <!-- Sidebar Bottom: Active Shortcut & Creator Attribution -->
                <StackPanel Grid.Row="2" Margin="12,6,12,12">
                    <!-- Active Shortcut Quick Pill -->
                    <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Active Shortcut:" FontSize="10" FontWeight="SemiBold" Foreground="#3B82F6" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding UnifiedHotkeyDisplay}" FontFamily="Consolas, Segoe UI" FontWeight="Bold" FontSize="13" Foreground="#1D4ED8"/>
                        </StackPanel>
                    </Border>

                    <!-- Creator Card with Photo -->
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="19" BorderBrush="#0078D4" BorderThickness="2" Margin="0,0,10,0">
                                <Border.Background>
                                    <ImageBrush ImageSource="/Resources/creator.png" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Powered by" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBlock Text="Vijit Pugalia" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right Content & Action Footer -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Active Tab Views -->
            <Grid Grid.Row="0">

                <!-- TAB 1: SHORTCUTS & GENERAL -->
                <ScrollViewer x:Name="GeneralTab" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24" MaxWidth="580">
                        <TextBlock Text="Shortcuts &amp; General" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                        <TextBlock Text="Configure how you trigger voice dictation across Windows applications." FontSize="13" Foreground="#64748B" Margin="0,0,0,18"/>

                        <!-- Primary Unified Dictation Shortcut Card -->
                        <Border Background="#F0F7FF" BorderBrush="#0078D4" BorderThickness="1.5" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚡ Unified Dictation Shortcut" FontWeight="Bold" FontSize="14" Foreground="#0078D4"/>
                                        <Border Background="#0078D4" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                            <TextBlock Text="Recommended" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="Hold to speak &amp; release to paste • Double-tap to record hands-free without holding" FontSize="12" Foreground="#475569" Margin="0,0,0,12"/>

                                <!-- Interactive Click-to-Record Active Badge -->
                                <Border Background="White" BorderBrush="#0078D4" BorderThickness="1.5" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Active Shortcut:" FontWeight="SemiBold" FontSize="12" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding UnifiedHotkeyDisplay}" FontWeight="Bold" FontSize="16" FontFamily="Consolas, Segoe UI" Foreground="#0078D4" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Command="{Binding RecordUnifiedHotkeyCommand}" Padding="14,6" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource HotkeyButton}">
                                                    <Setter Property="Content" Value="🎙️ Click to Record via Keyboard"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRecordingUnifiedHotkey}" Value="True">
                                                            <Setter Property="Content" Value="🔴 Listening... Press keys (Esc to cancel)"/>
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                            <Setter Property="BorderBrush" Value="#EF4444"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- 1-Click Popular Presets -->
                                <TextBlock Text="Quick Presets (Click to apply immediately):" FontWeight="SemiBold" FontSize="11" Foreground="#475569" Margin="0,0,0,6"/>
                                <WrapPanel>
                                    <Button Command="{Binding ApplyPresetHotkeyCommand}" CommandParameter="Ctrl+Win" Margin="0,0,6,6" Padding="12,6" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                <Setter Property="Content" Value="⚡ Ctrl + Windows"/>
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                <Setter Property="Foreground" Value="#334155"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCtrlWinSelected}" Value="True">
                                                        <Setter Property="Content" Value="✓ ⚡ Ctrl + Windows (Active)"/>
                                                        <Setter Property="Background" Value="#0078D4"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#005A9E"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Command="{Binding ApplyPresetHotkeyCommand}" CommandParameter="Alt+Space" Margin="0,0,6,6" Padding="12,6" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                <Setter Property="Content" Value="Alt + Space"/>
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                <Setter Property="Foreground" Value="#334155"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAltSpaceSelected}" Value="True">
                                                        <Setter Property="Content" Value="✓ Alt + Space (Active)"/>
                                                        <Setter Property="Background" Value="#0078D4"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#005A9E"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Command="{Binding ApplyPresetHotkeyCommand}" CommandParameter="Ctrl+Shift+Space" Margin="0,0,6,6" Padding="12,6" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                <Setter Property="Content" Value="Ctrl + Shift + Space"/>
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                <Setter Property="Foreground" Value="#334155"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCtrlShiftSpaceSelected}" Value="True">
                                                        <Setter Property="Content" Value="✓ Ctrl + Shift + Space (Active)"/>
                                                        <Setter Property="Background" Value="#0078D4"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#005A9E"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Command="{Binding ApplyPresetHotkeyCommand}" CommandParameter="Ctrl+Space" Margin="0,0,6,6" Padding="12,6" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                <Setter Property="Content" Value="Ctrl + Space"/>
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                <Setter Property="Foreground" Value="#334155"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCtrlSpaceSelected}" Value="True">
                                                        <Setter Property="Content" Value="✓ Ctrl + Space (Active)"/>
                                                        <Setter Property="Background" Value="#0078D4"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#005A9E"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Command="{Binding ApplyPresetHotkeyCommand}" CommandParameter="Win+H" Margin="0,0,6,6" Padding="12,6" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                <Setter Property="Content" Value="Win + H"/>
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                <Setter Property="Foreground" Value="#334155"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWinHSelected}" Value="True">
                                                        <Setter Property="Content" Value="✓ Win + H (Active)"/>
                                                        <Setter Property="Background" Value="#0078D4"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#005A9E"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Command="{Binding ApplyPresetHotkeyCommand}" CommandParameter="F8" Margin="0,0,6,6" Padding="12,6" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                <Setter Property="Content" Value="F8"/>
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                <Setter Property="Foreground" Value="#334155"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsF8Selected}" Value="True">
                                                        <Setter Property="Content" Value="✓ F8 (Active)"/>
                                                        <Setter Property="Background" Value="#0078D4"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#005A9E"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </WrapPanel>

                                <!-- Status Confirmation Banner -->
                                <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,8,0,0"
                                        Visibility="{Binding HasHotkeyStatusMessage, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="✓" FontWeight="Bold" Foreground="#16A34A" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding HotkeyStatusMessage}" FontWeight="SemiBold" FontSize="12" Foreground="#15803D"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Advanced Option: Separate Shortcuts for Hold and Toggle Modes -->
                        <Expander Header="⚙️ Advanced: Separate Shortcuts for Hold and Toggle Modes" IsExpanded="{Binding UseSeparateHotkeys}" Margin="0,0,0,16" FontWeight="SemiBold" Foreground="#334155">
                            <StackPanel Margin="0,8,0,0">
                                <CheckBox Content="Enable separate Hold and Toggle hotkeys" IsChecked="{Binding UseSeparateHotkeys}" FontWeight="Normal" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="Hold-to-Talk" FontWeight="Bold" FontSize="12" Foreground="#0F172A" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding HoldHotkeyDisplay}" FontWeight="Bold" FontFamily="Consolas" Foreground="#0078D4" Margin="0,0,0,8"/>
                                            <Button Content="Record Key" Command="{Binding RecordHoldHotkeyCommand}" Style="{StaticResource SecondaryButton}" Padding="8,5"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Toggle Mode" FontWeight="Bold" FontSize="12" Foreground="#0F172A" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding ToggleHotkeyDisplay}" FontWeight="Bold" FontFamily="Consolas" Foreground="#334155" Margin="0,0,0,8"/>
                                            <Button Content="Record Key" Command="{Binding RecordToggleHotkeyCommand}" Style="{StaticResource SecondaryButton}" Padding="8,5"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- Dictation Timing Card -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource CardHeader}">
                                    <TextBlock Text="⏱️" Style="{StaticResource CardIcon}"/>
                                    <TextBlock Text="Dictation Start Delay" Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource FieldDescription}" Margin="0,0,0,10">A brief delay before recording starts allows modifier keys to settle.</TextBlock>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Delay Duration:" Style="{StaticResource FieldLabel}" Margin="0"/>
                                    <TextBlock x:Name="DelayValueText" Grid.Column="1" Text="0 ms" FontSize="12" FontWeight="Bold" Foreground="#0078D4" FontFamily="Consolas" VerticalAlignment="Center"/>
                                </Grid>
                                <Slider x:Name="StartDelaySlider" Minimum="0" Maximum="500" Value="{Binding ShortcutStartDelay}" TickFrequency="25" IsSnapToTickEnabled="True" Margin="0,4,0,0" ValueChanged="StartDelaySlider_ValueChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Application Behavior Card -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource CardHeader}">
                                    <TextBlock Text="🚀" Style="{StaticResource CardIcon}"/>
                                    <TextBlock Text="Application Behavior" Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                                <CheckBox Content="Launch Murmur automatically when Windows starts" IsChecked="{Binding StartWithWindows}"/>
                                <CheckBox Content="Start minimized to system tray in background" IsChecked="{Binding StartMinimized}"/>
                            </StackPanel>
                        </Border>

                        <!-- Updates Card -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource CardHeader}">
                                    <TextBlock Text="🔄" Style="{StaticResource CardIcon}"/>
                                    <TextBlock Text="Software Updates" Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                                <CheckBox Content="Automatically check for updates on startup" IsChecked="{Binding AutoCheckUpdates}"/>
                                <Button x:Name="CheckUpdatesButton" Content="Check for Updates Now" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="CheckUpdatesButton_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 2: AUDIO & RECORDING -->
                <ScrollViewer x:Name="AudioTab" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Margin="28,24" MaxWidth="580">
                        <TextBlock Text="Audio &amp; Recording" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                        <TextBlock Text="Configure microphone input, volume levels, and floating indicator feedback." FontSize="13" Foreground="#64748B" Margin="0,0,0,18"/>

                        <!-- Microphone Card -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource CardHeader}">
                                    <TextBlock Text="🎙️" Style="{StaticResource CardIcon}"/>
                                    <TextBlock Text="Microphone Input Device" Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource FieldDescription}" Margin="0,0,0,10">Select your preferred audio capture device:</TextBlock>
                                
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ItemsControl x:Name="MicrophoneList" ItemsSource="{Binding AvailableDevices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="MicrophoneItem_Click">
                                                    <DockPanel>
                                                        <TextBlock x:Name="MicCheckmark" Text="✓ " Foreground="#0078D4" FontWeight="Bold" Visibility="Collapsed"/>
                                                        <TextBlock x:Name="MicCircle" Text="○ " Foreground="#94A3B8"/>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="13" Foreground="#0F172A"/>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                
                                <Button Content="🔄 Refresh Audio Devices" Command="{Binding RefreshDevicesCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- Sound Volume & Audio Ducking Card -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource CardHeader}">
                                    <TextBlock Text="🔊" Style="{StaticResource CardIcon}"/>
                                    <TextBlock Text="Sound Effects &amp; Feedback" Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                                <CheckBox Content="Play sound cues when dictation starts and stops" IsChecked="{Binding PlayAlertSounds}"/>
                                
                                <Grid Margin="0,10,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Volume:" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SoundVolume}" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                                    <TextBlock x:Name="VolumeValueText" Grid.Column="2" Text="100%" FontSize="12" FontWeight="Bold" Foreground="#0078D4" FontFamily="Consolas" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                                    <Button x:Name="PreviewSoundButton" Content="🔊 Test Sound Cue" Style="{StaticResource SecondaryButton}" Click="PreviewSoundButton_Click"/>
                                </StackPanel>

                                <Separator Margin="0,4,0,12" Background="#E2E8F0"/>
                                <CheckBox Content="Mute other system audio during dictation (Audio Ducking)" IsChecked="{Binding MuteOtherAudio}"/>
                                <TextBlock Style="{StaticResource FieldDescription}">Silences music, YouTube, and podcasts while you speak so Whisper receives clean voice audio.</TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Floating Recording Overlay HUD Card -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource CardHeader}">
                                    <TextBlock Text="💬" Style="{StaticResource CardIcon}"/>
                                    <TextBlock Text="Floating Recording HUD" Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                                <CheckBox Content="Show floating indicator overlay during recording" IsChecked="{Binding ShowRecordingIndicator}"/>
                                <TextBlock Style="{StaticResource FieldDescription}" Margin="0,0,0,10">A non-activating floating pill appears on screen showing live waveform and recording status.</TextBlock>

                                <Button x:Name="DebugOverlayButton" Content="Preview Overlay Pill" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="DebugOverlayButton_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 3: AI & API MODELS -->
                <ScrollViewer x:Name="AITab" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Margin="28,24" MaxWidth="580">
                        <TextBlock Text="AI &amp; API Models" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                        <TextBlock Text="Configure cloud or local inference endpoints, API keys, and speech models." FontSize="13" Foreground="#64748B" Margin="0,0,0,18"/>

                        <!-- API Credentials & Endpoint Card -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource CardHeader}">
                                    <TextBlock Text="🔑" Style="{StaticResource CardIcon}"/>
                                    <TextBlock Text="API Endpoint &amp; Credentials" Style="{StaticResource CardTitle}"/>
                                </StackPanel>

                                <TextBlock Text="Provider Base URL:" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" Margin="0,0,0,10"/>

                                <TextBlock Text="API Key:" Style="{StaticResource FieldLabel}"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="ApiKeyBox" Style="{StaticResource InputPasswordBox}" PasswordChanged="ApiKeyBox_PasswordChanged"/>
                                    <Button Grid.Column="1" x:Name="SaveApiKeyButton" Content="Save Key" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="SaveApiKeyButton_Click"/>
                                </Grid>

                                <!-- Prominent Test Connection Button -->
                                <DockPanel LastChildFill="False">
                                    <Button Content="⚡ Test Connection &amp; Validate API Key" Command="{Binding ValidateApiKeyCommand}" Style="{StaticResource PrimaryButton}"/>
                                </DockPanel>

                                <!-- Live Validation Status Banner -->
                                <Border Background="#F1F5F9" CornerRadius="6" Padding="12,8" Margin="0,12,0,0" Visibility="{Binding HasApiKeyValidationStatus, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding ValidationStatusMessage}" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- AI Models Card -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource CardHeader}">
                                    <TextBlock Text="🧠" Style="{StaticResource CardIcon}"/>
                                    <TextBlock Text="Speech &amp; Polish Models" Style="{StaticResource CardTitle}"/>
                                </StackPanel>

                                <TextBlock Text="Transcription Model (Whisper):" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding TranscriptionModel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" Margin="0,0,0,4"/>
                                <TextBlock Text="Default: whisper-large-v3" FontSize="11" Foreground="#64748B" Margin="0,0,0,12"/>

                                <TextBlock Text="Post-Processing Model (Polishing &amp; Formatting):" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding PostProcessingModel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" Margin="0,0,0,4"/>
                                <TextBlock Text="Default: openai/gpt-oss-20b or llama-3.3-70b-versatile" FontSize="11" Foreground="#64748B" Margin="0,0,0,12"/>

                                <TextBlock Text="Output Language:" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="OutputLanguageCombo" SelectedIndex="0" Padding="10,8" Margin="0,0,0,4">
                                    <ComboBoxItem Content="Auto-detect (Recommended)"/>
                                    <ComboBoxItem Content="English"/>
                                    <ComboBoxItem Content="Spanish"/>
                                    <ComboBoxItem Content="French"/>
                                    <ComboBoxItem Content="German"/>
                                    <ComboBoxItem Content="Japanese"/>
                                    <ComboBoxItem Content="Chinese"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- System Prompts & Context Awareness Card -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource CardHeader}">
                                    <TextBlock Text="📝" Style="{StaticResource CardIcon}"/>
                                    <TextBlock Text="System Prompts &amp; Safety" Style="{StaticResource CardTitle}"/>
                                </StackPanel>

                                <TextBlock Text="Whisper System Prompt (Vocabulary Guidance):" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="SystemPromptBox" Style="{StaticResource InputTextBox}" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,12"/>

                                <CheckBox x:Name="InstructionGuardCheckBox" Content="Instruction Guard: Prevent dictated text from executing commands" Margin="0,0,0,8"/>
                                <CheckBox Content="Context Awareness: Include foreground application title in prompt" IsChecked="{Binding IncludeActiveWindowContext}" Margin="0,0,0,8"/>

                                <TextBlock Text="Context Prompt Template:" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ContextPromptBox" Style="{StaticResource InputTextBox}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 4: MACROS & VOCABULARY -->
                <ScrollViewer x:Name="MacrosTab" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Margin="28,24" MaxWidth="580">
                        <TextBlock Text="Macros &amp; Vocabulary" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                        <TextBlock Text="Teach Murmur proprietary terms, brand names, and voice expansion snippets." FontSize="13" Foreground="#64748B" Margin="0,0,0,18"/>

                        <!-- Custom Vocabulary Card -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource CardHeader}">
                                    <TextBlock Text="📖" Style="{StaticResource CardIcon}"/>
                                    <TextBlock Text="Custom Vocabulary Dictionary" Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource FieldDescription}" Margin="0,0,0,8">Enter specialized words, acronyms, medical/legal terminology, or people's names separated by commas:</TextBlock>
                                <TextBox Text="{Binding CustomVocabulary, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
                            </StackPanel>
                        </Border>

                        <!-- Voice Macros Card -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="✨" Style="{StaticResource CardIcon}"/>
                                        <TextBlock Text="Voice Macros &amp; Snippets" Style="{StaticResource CardTitle}"/>
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" x:Name="AddMacroButton" Content="+ Add Voice Macro" Style="{StaticResource PrimaryButton}" Padding="12,6" Click="AddMacroButton_Click"/>
                                </DockPanel>

                                <Border x:Name="MacrosEmptyState" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,8,0,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="✨" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                        <TextBlock Text="No Voice Macros Configured" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Click '+ Add Voice Macro' to define trigger phrases that expand into canned text." FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <ItemsControl x:Name="MacrosList" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 5: ADVANCED & LOGS -->
                <ScrollViewer x:Name="AdvancedTab" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Margin="28,24" MaxWidth="580">
                        <TextBlock Text="Advanced &amp; Logs" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                        <TextBlock Text="Manage private clipboard history, temporary audio files, and inspection logs." FontSize="13" Foreground="#64748B" Margin="0,0,0,18"/>

                        <!-- Private Clipboard & Formatting Card -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource CardHeader}">
                                    <TextBlock Text="🔒" Style="{StaticResource CardIcon}"/>
                                    <TextBlock Text="Clipboard Privacy &amp; Rich Formatting" Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                                <CheckBox Content="Exclude dictations from Windows clipboard history (Win + V) and cloud sync" IsChecked="{Binding KeepInClipboardHistory, Converter={StaticResource InverseBool}}"/>
                                <TextBlock Style="{StaticResource FieldDescription}" Margin="24,0,0,8">Prevents spoken text, passwords, or patient notes from appearing in public Windows clipboard history.</TextBlock>

                                <CheckBox Content="Preserve existing clipboard contents after pasting" IsChecked="{Binding PreserveClipboard}"/>
                                <CheckBox Content="Automatically paste transcript into active window upon completion" IsChecked="{Binding AutoPaste, FallbackValue=True}"/>
                                <CheckBox Content="Press Enter automatically after pasting transcript" IsChecked="{Binding PressEnterAfterPaste}"/>
                            </StackPanel>
                        </Border>

                        <!-- Storage & Cleanup Card -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource CardHeader}">
                                    <TextBlock Text="🗑️" Style="{StaticResource CardIcon}"/>
                                    <TextBlock Text="Storage &amp; Audio Cleanup" Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                                <CheckBox Content="Automatically delete temporary WAV recording files after transcription" IsChecked="{Binding AutoDeleteRecordings, FallbackValue=True}"/>
                                <TextBlock Style="{StaticResource FieldDescription}" Margin="24,0,0,8">Saves disk space and ensures zero voice data is retained locally.</TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Embedded Dictation Run Log Card -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📋" Style="{StaticResource CardIcon}"/>
                                        <TextBlock Text="Recent Dictations (Run Log)" Style="{StaticResource CardTitle}"/>
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" x:Name="ClearHistoryButton" Content="Clear Run Log" Style="{StaticResource SecondaryButton}" Padding="10,5" Click="ClearHistoryButton_Click"/>
                                </DockPanel>

                                <Border x:Name="RunLogEmptyState" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,6,0,6">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="📝" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock Text="No Recent Dictations" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Dictate text anywhere and your transcripts will be logged here." FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <ItemsControl x:Name="RunLogList" Visibility="Collapsed">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:g}'}" FontSize="11" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding CleanTranscript}" FontSize="13" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Copy" Tag="{Binding}" Style="{StaticResource SecondaryButton}" Padding="8,4" VerticalAlignment="Center" Margin="10,0,0,0" Click="RunLogCopy_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Diagnostics, Debug & Reset Card -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource CardHeader}">
                                    <TextBlock Text="🛠️" Style="{StaticResource CardIcon}"/>
                                    <TextBlock Text="Diagnostics &amp; Debugging" Style="{StaticResource CardTitle}"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="BuildInfoText" Text="Murmur 1.0.0 (Windows x64)" FontSize="12" Foreground="#64748B" FontFamily="Consolas, Segoe UI" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" x:Name="CopyBuildInfoButton" Content="Copy Info" Style="{StaticResource SecondaryButton}" Padding="10,5" Click="CopyBuildInfoButton_Click"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                                    <Button x:Name="OpenDebugLogButton" Content="📂 Open Log File" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OpenDebugLogButton_Click"/>
                                    <Button x:Name="ClearDebugLogButton" Content="🗑️ Clear Debug Log" Style="{StaticResource SecondaryButton}" Click="ClearDebugLogButton_Click"/>
                                </StackPanel>

                                <Separator Margin="0,4,0,12" Background="#E2E8F0"/>
                                <Button Content="Reset All Settings to Factory Defaults" Command="{Binding ResetCommand}" Style="{StaticResource SecondaryButton}" Foreground="#DC2626" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- About Murmur & Creator Attribution Card -->
                        <Border Style="{StaticResource SettingsCard}" Background="#F8FAFC" BorderBrush="#CBD5E1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Circular Portrait Photo -->
                                <Border Grid.Column="0" Width="68" Height="68" CornerRadius="34" BorderBrush="#0078D4" BorderThickness="2" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
                                    </Border.Effect>
                                    <Border.Background>
                                        <ImageBrush ImageSource="/Resources/creator.png" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>

                                <!-- App Details & Attribution -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="Murmur" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                        <Border Background="#E2E8F0" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="v1.1" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Created &amp; Powered by Vijit Pugalia" FontSize="13" FontWeight="SemiBold" Foreground="#0078D4" Margin="0,0,0,4"/>
                                    <TextBlock Text="Free and open source AI voice dictation with local intelligence, unified hotkeys, and privacy-first clipboard protection." FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <TextBlock Text="GitHub: https://github.com/VijitPugalia/Murmur" FontSize="11" Foreground="#475569" FontFamily="Consolas, Segoe UI"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

            </Grid>

            <!-- Sticky Bottom Action Bar -->
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,12">
                <DockPanel LastChildFill="False">
                    <!-- Status / Unsaved Changes Indicator -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="● " FontSize="12" Foreground="#D97706" Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="Unsaved changes" FontSize="12" FontWeight="SemiBold" Foreground="#D97706" VerticalAlignment="Center" Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>

                    <!-- Primary & Secondary Action Buttons -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Reset" Command="{Binding ResetCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                        <Button Content="Close" Click="CloseButton_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                        <Button Content="✓ Save &amp; Apply" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
