<Window x:Class="Murmur.App.Windows.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Murmur - Dictation History"
        Height="560" Width="680"
        MinHeight="400" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F7"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Search Box Style -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="SmallActionButton" TargetType="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="#F0F0F2"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E4E4E8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryPasteButton" TargetType="Button" BasedOn="{StaticResource SmallActionButton}">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1A1A1A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeleteButton" TargetType="Button" BasedOn="{StaticResource SmallActionButton}">
            <Setter Property="Foreground" Value="#C0392B"/>
            <Setter Property="Background" Value="#FFF0F0"/>
            <Setter Property="BorderBrush" Value="#FFD0D0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Dictation History" FontSize="20" FontWeight="Bold" Foreground="#1A1A1A"/>
                <TextBlock x:Name="ItemCountText" Text="Loading history..." FontSize="12" Foreground="#888888" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ClearAllButton" Content="Clear All" Style="{StaticResource DeleteButton}" Click="ClearAllButton_Click" Margin="0,0,8,0"/>
                <Button Content="Close (Esc)" Style="{StaticResource SmallActionButton}" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Search Box -->
        <TextBox x:Name="SearchBox" Grid.Row="1" Style="{StaticResource SearchBox}" TextChanged="SearchBox_TextChanged" Margin="0,0,0,14"/>

        <!-- History List / Empty State -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="10" Padding="8">
            <Grid>
                <!-- Empty State -->
                <StackPanel x:Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="No dictation records found" FontSize="14" FontWeight="SemiBold" Foreground="#888888" HorizontalAlignment="Center"/>
                    <TextBlock Text="Speak using your hotkey to populate history." FontSize="12" Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Scrollable Items -->
                <ScrollViewer x:Name="HistoryScrollViewer" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="HistoryItemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FAFAFC" BorderBrush="#EFEFF2" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Top metadata: App badge, timestamp, duration -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#E8E8ED" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" Visibility="{Binding AppNameVisibility}">
                                                    <TextBlock Text="{Binding AppName}" FontSize="11" FontWeight="SemiBold" Foreground="#444448"/>
                                                </Border>
                                                <TextBlock Text="{Binding RelativeTime}" FontSize="11" Foreground="#888888" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DurationText}" FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </StackPanel>

                                            <!-- Actions: Paste, Copy, Delete -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="Paste Again" Style="{StaticResource PrimaryPasteButton}" Click="PasteItem_Click" Tag="{Binding}" Margin="0,0,6,0"/>
                                                <Button Content="Copy" Style="{StaticResource SmallActionButton}" Click="CopyItem_Click" Tag="{Binding}" Margin="0,0,6,0"/>
                                                <Button Content="✕" Style="{StaticResource DeleteButton}" Click="DeleteItem_Click" Tag="{Binding}" Width="26" Padding="0"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Transcript Content -->
                                        <TextBlock Grid.Row="1" Text="{Binding CleanTranscript}" FontSize="13" Foreground="#222222" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="18"/>

                                        <!-- Raw transcript if different -->
                                        <TextBlock Grid.Row="2" Text="{Binding RawTranscriptPreview}" FontSize="11" Foreground="#999999" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding RawVisibility}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="3" Text="Press Esc to close • Click 'Paste Again' to insert text into previous window" FontSize="11" Foreground="#999999" Margin="4,10,0,0"/>
    </Grid>
</Window>
